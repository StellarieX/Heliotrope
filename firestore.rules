rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reserved route names and format. Mirrors lib/username.ts, but enforced
    // here too: the client check alone is bypassed by writing to Firestore
    // directly. (Kept in functions, not inline, because the regex quantifier
    // braces would break the brace-matching in tests/e2e's rules parser.)
    function validName(n) {
      return n is string
        && n.matches('^[a-z0-9_]{3,20}$')
        && !(n in ['dashboard', 'account', 'api', 'admin', 'login', 'signin',
                   'signout', 'settings', 'help', 'about', 'null', 'undefined']);
    }

    // Public profile document. World-readable (the /[username] page needs it),
    // so it may only ever hold non-sensitive fields: NO email. Anything outside
    // this allow-list is rejected, which also stops arbitrary data hosting.
    function validProfile(d) {
      return d.keys().hasOnly(['username', 'displayName', 'photoURL', 'occupation',
                               'place', 'rooms', 'onboarded', 'updatedAt'])
        && (!('username' in d) || validName(d.username))
        && (!('displayName' in d) || d.displayName == null
            || (d.displayName is string && d.displayName.size() <= 80))
        && (!('photoURL' in d) || d.photoURL == null
            || (d.photoURL is string && d.photoURL.size() <= 2048
                && d.photoURL.matches('^https://.*')))
        && (!('occupation' in d) || d.occupation == null
            || (d.occupation is string && d.occupation.size() <= 40))
        && (!('place' in d) || d.place == null
            || (d.place is string && d.place.size() <= 40))
        && (!('rooms' in d) || d.rooms == null
            || (d.rooms is number && d.rooms >= 0 && d.rooms <= 100000))
        && (!('onboarded' in d) || d.onboarded is bool);
    }

    function optNum(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }

    function optStr(d, k, maxLen) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= maxLen);
    }

    // A saved load. Allow-listed keys only; numbers bounded so the doc can't be
    // abused as storage. Values are re-validated by the backend before planning.
    function validJob(d) {
      return d.keys().hasOnly(['name', 'kind', 'shiftable', 'powerKw', 'readyBy', 'flexHours',
                               'jobType', 'energyKwh', 'durationMin', 'tempMinC', 'tempMaxC',
                               'tempTargetC', 'confidence', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && optStr(d, 'kind', 60)
        && (!('shiftable' in d) || d.shiftable is bool)
        && optNum(d, 'powerKw', 0, 100000)
        && optStr(d, 'readyBy', 10)
        && optNum(d, 'flexHours', 0, 168)
        && (!('jobType' in d) || d.jobType in ['FIXED', 'DEFERRABLE_ATOMIC',
                                                'DEFERRABLE_INTERRUPTIBLE', 'THERMAL'])
        && optNum(d, 'energyKwh', 0, 1000000)
        && optNum(d, 'durationMin', 0, 10080)
        && optNum(d, 'tempMinC', -50, 150)
        && optNum(d, 'tempMaxC', -50, 150)
        && optNum(d, 'tempTargetC', -50, 150)
        && optNum(d, 'confidence', 0, 1)
        && optStr(d, 'createdAt', 40);
    }

    function validSettings(d) {
      return d.keys().hasOnly(['maxPowerKw', 'updatedAt'])
        && optNum(d, 'maxPowerKw', 0, 100000);
    }

    // User profile documents: public read so /[username] pages resolve;
    // only the account owner may write their own profile document.
    // `request.resource == null` is a delete, which has no payload to validate.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && (request.resource == null || validProfile(request.resource.data));

      // Private per-user loads: only the owner may read or write, and only the
      // fields the app writes, with sane types and sizes.
      match /jobs/{jobId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && validJob(request.resource.data);
      }

      // Private per-user settings (e.g. "Max power at once"): owner only.
      match /settings/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && docId == 'prefs' && validSettings(request.resource.data);
      }
    }

    // Username claim registry: anyone may read (public lookup);
    // claim creation, modification, and deletion are restricted to the owner of the UID.
    // The `is string` guard on create rejects missing/null/non-string uid
    // payloads explicitly instead of relying on fail-closed comparison.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid is string && request.resource.data.uid == request.auth.uid && validName(name) && request.resource.data.keys().hasOnly(['uid', 'updatedAt']);
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'updatedAt']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // NOTE: no recursive-wildcard catch-all is used here on purpose:
    // test_boundary_no_wildcard_subcollection_leak forbids recursive
    // wildcards file-wide (they risk leaking /users/{uid} subcollections if
    // ever reordered). Unmatched collections are already denied by
    // Firestore's default-deny, so omitting the catch-all loses nothing.
  }
}
