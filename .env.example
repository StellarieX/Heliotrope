# Frontend: copy to .env.local. Publishable values are visible in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend only: never prefix these with NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_URL=
# HELIOTROPE_ENV=development
# CORS_ALLOW_ORIGINS=
# CARBON_PROVIDER=weather
# JEV_API_KEY=

# Production frontend server rewrite target:
# BACKEND_URL=https://your-backend.example
