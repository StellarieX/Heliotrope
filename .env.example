# Frontend (public, NEXT_PUBLIC_* only). Copy to .env.local and fill values.
# Never put secrets here — NEXT_PUBLIC_* vars are bundled into the browser JS.

# Firebase web config (Firebase console > Project settings > Your apps).
# lib/firebase.ts treats the app as configured when the API key is set.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local-only: set to 1 to use the Firebase emulators (Auth :9099, Firestore :8080)
# instead of a real project. Start them with:
#   npx firebase emulators:start --only auth,firestore --project demo-heliotrope
# Never set this in production.
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1

# Backend base URL consumed as BASE in lib/api/client.ts.
# When unset: http://localhost:8000 in dev, same-origin /api/v1/... in a production build.
# Local dev: leave as http://localhost:8000.
# Vercel production: leave it UNSET (Vercel cannot store an empty value). The bundle
# then uses same-origin relative URLs (/api/v1/...), which next.config.ts rewrites
# server-side to BACKEND_URL below. Same-origin needs no CORS and leaks no backend host.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Backend (server-only; set in the backend environment, never NEXT_PUBLIC_) ---
# HELIOTROPE_ENV=development
# PORT=8000
# LOG_LEVEL=info
# CORS_ALLOW_ORIGINS=
# CARBON_PROVIDER=weather   (live solar/wind-based estimate, no key; library default is synthetic)
# CARBON_LAT=23.2599
# CARBON_LON=77.4126
# CARBON_UTC_OFFSET_HOURS=5.5
# CARBON_CSV_PATH=
# CARBON_MAX_RANGE_DAYS=7
# CARBON_CACHE_TTL_S=300
# CARBON_SYNTHETIC_SEED=7
# LOAD_INTELLIGENCE_PROVIDER=auto   (Jev AI classifier when a key is set; rule_based = never call the model)
# DEFAULT_LOAD_TIMEZONE=UTC
# ELECTRICITY_MAPS_API_KEY=
# ELECTRICITY_MAPS_ZONE=US-CAL-CISO
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_CALLS_PER_MIN=30
# JEV_API_KEY=  (legacy alias for GEMINI_API_KEY; GEMINI_API_KEY wins when both are set)

# --- Vercel dashboard vars (NOT in .env.local; set per project/environment) ---
# BACKEND_URL=https://<your-backend-host>
#   Server-only rewrite target used by next.config.ts to proxy /api/v1/:path*
#   to the FastAPI backend. Required in Vercel production when
#   NEXT_PUBLIC_BACKEND_URL is unset. Never prefix with NEXT_PUBLIC_.
# CORS_ALLOW_ORIGINS=https://<your-app>.vercel.app
#   Only needed if the browser ever calls the backend cross-origin (i.e. you
#   did NOT use same-origin mode). The backend also auto-trusts Vercel's own
#   VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL hosts when set, so manual
#   per-deployment entries are unnecessary (see backend/app/core/config.py).
# HELIOTROPE_ENV=production
