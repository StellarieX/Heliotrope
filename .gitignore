# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# python
__pycache__/
*.pyc
backend/.venv/
.venv/
venv/
.pytest_cache/
.hypothesis/
.coverage/

# local tool output
*.log
.firebase/
*.egg-info/

# sqlite / local execution store
*.db
*.sqlite
*.sqlite3
backend/data/

# vercel
.vercel

# internal notes (never tracked)
.agents/

# typescript
*.tsbuildinfo
next-env.d.ts

# assistant / editor tooling
.claude/
CLAUDE.md
.vscode/
.idea/
